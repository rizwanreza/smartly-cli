---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import { withBase } from '../lib/url';

import instrumentLatin from '../assets/fonts/instrument-sans-latin.woff2';
import geistRegular from '../assets/fonts/geist-mono-regular.woff2';

interface Props {
  title: string;
  description: string;
  /** Appended to the site name in <title>. Set false on the landing page. */
  suffix?: boolean;
  bodyClass?: string;
}

const { title, description, suffix = true, bodyClass = '' } = Astro.props;

const pageTitle = suffix ? `${title} — smartly` : title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('/og.png'), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#151716" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="smartly" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="smartly — tell your shell what you mean."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={instrumentLatin}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={geistRegular}
      crossorigin
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileDrawer />
    <SearchDialog />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
