---
import Base from '../layouts/Base.astro';
import Swatch from '../components/Swatch.astro';
import { withBase } from '../lib/url';
import { REPO_URL } from '../../site.config.mjs';

const sections = [
  { id: 'idea', label: 'Brand idea' },
  { id: 'taglines', label: 'Taglines' },
  { id: 'logo', label: 'Logo' },
  { id: 'text-logo', label: 'Text logo' },
  { id: 'colour', label: 'Colour' },
  { id: 'typography', label: 'Typography' },
  { id: 'symbols', label: 'Terminal symbols' },
  { id: 'voice', label: 'Voice' },
  { id: 'in-use', label: 'In use' },
];

const personality = [
  { trait: 'Calm', gloss: 'Nothing is urgent. Nothing is announced.' },
  { trait: 'Capable', gloss: 'It has done this before, many times.' },
  { trait: 'Precise', gloss: 'One command. The right flags. No hedging.' },
  { trait: 'Fast', gloss: 'A sentence, then a result. No ceremony in between.' },
  { trait: 'Lightly playful', gloss: 'One small wink, well placed.' },
  {
    trait: 'Trustworthy around consequences',
    gloss: 'When something will actually run, it says so plainly.',
  },
];

const colours = [
  {
    name: 'Ink',
    hex: '#151716',
    token: '--ink',
    role: 'Body text, dark surfaces, primary buttons.',
  },
  {
    name: 'White',
    hex: '#FFFFFF',
    token: '--white',
    role: 'The primary surface.',
    outline: true,
  },
  {
    name: 'Warm paper',
    hex: '#F4F1E8',
    token: '--paper',
    role: 'Secondary surface: code blocks, bands, panels.',
    outline: true,
  },
  {
    name: 'Electric cyan',
    hex: '#00DDF5',
    token: '--cyan',
    role: 'Terminal symbols, active nav, focus halo, small delights.',
  },
  {
    name: 'Deep cyan',
    hex: '#007F91',
    token: '--cyan-deep',
    role: 'Link underlines and cyan that has to survive on white.',
  },
  {
    name: 'Warning amber',
    hex: '#FFB547',
    token: '--amber',
    role: 'The rule beside anything that will actually run.',
  },
  {
    name: 'Error red',
    hex: '#F05D5E',
    token: '--red',
    role: 'Failure states only. Never decoration.',
  },
];

const symbols = [
  {
    glyph: '›',
    name: 'Request',
    meaning: 'What a person typed, in plain English.',
    tone: 'muted',
  },
  {
    glyph: '→',
    name: 'Generated command',
    meaning: 'What smartly produced from that sentence.',
    tone: 'cyan',
  },
  {
    glyph: '$',
    name: 'Shell prompt',
    meaning: 'A command the reader types themselves.',
    tone: 'cyan',
  },
  {
    glyph: '!',
    name: 'Consequence',
    meaning: 'Something runs, is sent, or is written to disk.',
    tone: 'amber',
  },
  {
    glyph: '·',
    name: 'Nothing ran',
    meaning: 'Dry-run output, or a declined confirmation.',
    tone: 'muted',
  },
];

const copyExamples = [
  {
    good: "Here's the command.",
    bad: 'Your genius AI copilot has completed the mission!',
    why: 'State the result. The reader can see it is impressive.',
  },
  {
    good: 'Nothing ran.',
    bad: 'No worries — nothing to see here! 🎉',
    why: 'Two words, unambiguous. Emoji do not add certainty.',
  },
  {
    good: 'Commands without the ceremony.',
    bad: 'Unleash the revolutionary power of AI!',
    why: 'Describe the product, not the category.',
  },
  {
    good: 'Describe the result. Skip the flag archaeology.',
    bad: 'Let our intelligent agent handle the heavy lifting for you.',
    why: 'A concrete pain, named in the reader’s own words.',
  },
  {
    good: 'Auto-run is the default, including for destructive commands.',
    bad: 'Smartly runs safely so you never have to worry.',
    why: 'Never soften a consequence. Humour goes around the workflow, not around risk.',
  },
];
---

<Base
  title="Brand"
  description="The canonical Smartly brand guideline: brand idea, taglines, logo usage, colour tokens, typography, terminal symbols and voice."
>
  <article class="brand">
    <header class="brand__hero shell">
      <p class="eyebrow">Brand guideline</p>
      <h1 class="brand__title">Quiet magic,<br />with a slightly sly voice.</h1>
      <p class="brand__lede">
        Smartly should feel like an experienced engineer who remembers every
        obscure flag and does not make a production out of it. This page is the
        canonical reference for anyone writing, designing or shipping something
        with the Smartly name on it.
      </p>
    </header>

    <div class="shell brand__layout">
      <nav class="brand__toc" aria-label="On this page" data-toc>
        <h2 class="brand__toc-title">Contents</h2>
        <ul>
          {
            sections.map((section) => (
              <li>
                <a href={`#${section.id}`}>{section.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="brand__body">
        <!-- ============================================ brand idea -->
        <section class="brand__section" id="idea">
          <h2 class="heading">Brand idea</h2>
          <p class="brand__big">
            You know what you want to happen. Smartly knows the incantation.
          </p>
          <p>
            Everything in the product is one exchange: a sentence goes in, a
            command comes out, and the command is right. The brand's job is to
            make that exchange feel unremarkable — the way a very good colleague
            answering a question is unremarkable — while being quietly precise
            about the moments that carry consequences.
          </p>

          <h3 class="heading" id="personality">Personality</h3>
          <dl class="traits">
            {
              personality.map((item) => (
                <div class="traits__row">
                  <dt>{item.trait}</dt>
                  <dd>{item.gloss}</dd>
                </div>
              ))
            }
          </dl>

          <h3 class="heading" id="not">What it is not</h3>
          <p>
            Not a magical assistant, not a copilot, not a teammate. Smartly does
            not have a personality of its own in the interface — it has good
            manners. Avoid anthropomorphic language, hype, and any suggestion
            that the model is infallible.
          </p>
        </section>

        <!-- ============================================== taglines -->
        <section class="brand__section" id="taglines">
          <h2 class="heading">Taglines</h2>

          <div class="tagline tagline--primary">
            <p class="tagline__label mono">Primary</p>
            <p class="tagline__text">Tell your shell what you mean.</p>
            <p class="tagline__note">
              Use as the headline wherever Smartly is introduced. Sentence case,
              full stop included. Do not shorten it.
            </p>
          </div>

          <div class="tagline">
            <p class="tagline__label mono">Supporting</p>
            <p class="tagline__text tagline__text--sm">
              You know what. Smartly knows how.
            </p>
            <p class="tagline__note">
              Sits under the primary tagline, never instead of it. This is the
              one permitted wink — do not add a second one nearby.
            </p>
          </div>
        </section>

        <!-- ================================================== logo -->
        <section class="brand__section" id="logo">
          <h2 class="heading">Logo</h2>
          <p>
            The wordmark plus the cyan terminal chevron is the primary mark. Use
            the supplied SVG. Do not redraw it, re-typeset it, distort it or add
            effects to it.
          </p>

          <div class="logo-previews">
            <figure class="logo-preview logo-preview--white">
              <img
                src={withBase('/brand/smartly-logo-light.svg')}
                alt="The smartly logo on a white background"
                width="760"
                height="240"
              />
              <figcaption class="mono">On white — the default</figcaption>
            </figure>

            <figure class="logo-preview logo-preview--ink">
              <span class="logo-plate">
                <img
                  src={withBase('/brand/smartly-logo-light.svg')}
                  alt="The smartly logo, on its white plate, placed on an ink background"
                  width="760"
                  height="240"
                />
              </span>
              <figcaption class="mono">
                On ink — keep the logo on its white plate
              </figcaption>
            </figure>
          </div>

          <p class="note">
            There is currently one logo asset, and it carries its own white
            plate. On ink or photographic backgrounds, place it on that plate
            rather than knocking the wordmark out to white — a reversed lockup
            does not exist yet, and inventing one is a re-typesetting of the
            mark.
          </p>

          <h3 class="heading" id="assets">Assets</h3>
          <ul class="downloads">
            <li>
              <a href={withBase('/brand/smartly-logo-light.svg')} download>
                <span class="downloads__name">smartly-logo-light.svg</span>
                <span class="downloads__meta mono">SVG · 760 × 240 · primary lockup</span>
              </a>
            </li>
            <li>
              <a href={withBase('/brand/smartly-mark.svg')} download>
                <span class="downloads__name">smartly-mark.svg</span>
                <span class="downloads__meta mono">
                  SVG · the cyan <code>&gt;_</code> alone, on transparent
                </span>
              </a>
            </li>
            <li>
              <a href={withBase('/favicon.svg')} download>
                <span class="downloads__name">favicon.svg</span>
                <span class="downloads__meta mono">SVG · mark on an ink plate · 512 × 512</span>
              </a>
            </li>
          </ul>
          <p class="note">
            The mark and favicon are the same two cyan paths as the primary
            lockup — identical coordinates, stroke width and caps — cropped by
            the viewBox and, in the favicon, uniformly scaled. No re-drawing is
            involved in either.
          </p>

          <h3 class="heading" id="clear-space">Clear space</h3>
          <p>
            Keep clear space equal to the height of the chevron on every side.
            In the supplied SVG that is <code>106</code> units — roughly 44% of the
            asset's height. Nothing else sits inside that margin: no text, no rules,
            no other marks.
          </p>

          <div class="clearspace" aria-hidden="true">
            <div class="clearspace__margin">
              <div class="clearspace__inner">
                <img
                  src={withBase('/brand/smartly-logo-light.svg')}
                  alt=""
                  width="760"
                  height="240"
                />
              </div>
            </div>
          </div>
          <p class="caption">
            The tinted band is the minimum clear space, not part of the mark.
          </p>

          <h3 class="heading" id="minimum-sizes">Minimum sizes</h3>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th scope="col">Use</th>
                  <th scope="col">Asset</th>
                  <th scope="col">Minimum</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">Screen, primary lockup</th>
                  <td><code>smartly-logo-light.svg</code></td>
                  <td>96 px wide (≈ 30 px tall)</td>
                </tr>
                <tr>
                  <th scope="row">Print, primary lockup</th>
                  <td><code>smartly-logo-light.svg</code></td>
                  <td>28 mm wide</td>
                </tr>
                <tr>
                  <th scope="row">Mark only</th>
                  <td><code>smartly-mark.svg</code></td>
                  <td>16 px — below that use the ink-plate favicon</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 class="heading" id="usage">Correct and incorrect use</h3>
          <div class="rules">
            <div class="rules__col rules__col--do">
              <h4 class="rules__title">Do</h4>
              <ul>
                <li>Use the supplied SVG at any size above the minimum.</li>
                <li>Scale it uniformly.</li>
                <li>Give it its full clear space.</li>
                <li>
                  Place it on white, warm paper, or on its own plate over ink.
                </li>
                <li>
                  Use the mark alone when the name is already present nearby.
                </li>
              </ul>
            </div>
            <div class="rules__col rules__col--dont">
              <h4 class="rules__title">Don't</h4>
              <ul>
                <li>Re-typeset the wordmark in another face.</li>
                <li>Stretch, condense, rotate or skew it.</li>
                <li>Recolour the chevron, or the wordmark, to anything else.</li>
                <li>Add shadows, glows, gradients or outlines.</li>
                <li>Put it on a busy image, or inside a rounded pill.</li>
                <li>Lock it up with another logo without clear space between.</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- ============================================= text logo -->
        <section class="brand__section" id="text-logo">
          <h2 class="heading">Text logo</h2>
          <p>
            Where an image cannot go — a README heading, a terminal banner, a
            plain-text signature — the canonical text form is:
          </p>

          <button
            class="textlogo"
            type="button"
            data-copy-value="smartly >_"
            aria-label="Copy the text logo"
          >
            <span class="textlogo__mark">smartly&nbsp;<span class="textlogo__cursor">&gt;_</span></span>
            <span class="textlogo__copy mono" data-copy-feedback>Copy</span>
          </button>

          <ul class="plain">
            <li>Always lowercase. <code>Smartly</code> is the brand in prose; <code>smartly</code> is the command and the logo.</li>
            <li>One space between the word and the <code>&gt;_</code>.</li>
            <li>Set in Geist Mono where the medium allows it.</li>
            <li>Never <code>&gt;</code> alone, never <code>&gt;&gt;</code>, never a blinking cursor.</li>
          </ul>
        </section>

        <!-- ================================================ colour -->
        <section class="brand__section" id="colour">
          <h2 class="heading">Colour</h2>
          <p>
            Seven values. The experience is light — white and warm paper
            surfaces with ink type — and cyan is an accent, never a field.
            Select a swatch to copy its hex.
          </p>

          <div class="swatches">
            {colours.map((colour) => <Swatch {...colour} />)}
          </div>

          <h3 class="heading" id="colour-rules">Using them</h3>
          <ul class="plain">
            <li>
              <strong>Electric cyan is for small, functional moments</strong> —
              the <code>→</code> before a generated command, an active nav
              indicator, a focus halo, an underline on hover. Not for large text
              on white, where it drops to 1.7:1 and stops being readable.
            </li>
            <li>
              <strong>Deep cyan is the readable cyan.</strong> Use it wherever
              cyan has to carry meaning as text or as a control edge on a light
              surface.
            </li>
            <li>
              <strong>Amber marks consequence, not mood.</strong> A 3px rule
              beside the paragraph that says something will run. Never a full
              amber panel, and never for emphasis in general.
            </li>
            <li>
              <strong>Red is failure only.</strong> Error states, failed exits.
              It has no decorative use.
            </li>
            <li>
              <strong>Ink surfaces are rationed.</strong> One dark moment per
              page at most, where the terminal genuinely belongs.
            </li>
          </ul>

          <p class="note">
            Functional text and controls must clear 4.5:1. Two derived values
            exist for that reason and are documented rather than improvised:
            <code>#006473</code> for cyan text on warm paper, and
            <code>#8A5200</code> for amber-family text.
          </p>
        </section>

        <!-- ============================================ typography -->
        <section class="brand__section" id="typography">
          <h2 class="heading">Typography</h2>

          <div class="typespec">
            <div class="typespec__row">
              <div class="typespec__meta">
                <p class="typespec__name">Instrument Sans</p>
                <p class="typespec__use mono">Interface · editorial · headlines</p>
                <p class="typespec__detail">
                  400 for body, 500 for controls, 600 for headings. Tighten
                  tracking as size grows — display sizes sit at −0.035em.
                </p>
              </div>
              <p class="typespec__specimen typespec__specimen--sans">
                Tell your shell what you mean.
              </p>
            </div>

            <div class="typespec__row">
              <div class="typespec__meta">
                <p class="typespec__name">Geist Mono</p>
                <p class="typespec__use mono">
                  Code · terminal · configuration · labels · metadata
                </p>
                <p class="typespec__detail">
                  400 for code, 500 for labels. Eyebrows and small labels are
                  uppercase at 0.14em tracking — the only place Smartly shouts,
                  and it does so at 11px.
                </p>
              </div>
              <p class="typespec__specimen typespec__specimen--mono">
                find . -type f -exec sed -i '' 's/git/svn/g' &#123;&#125; +
              </p>
            </div>
          </div>

          <ul class="plain">
            <li>Self-host both faces. No third-party font requests, ever.</li>
            <li>
              Anything a person would type or read in a terminal is set in Geist
              Mono: commands, flags, file paths, config keys, environment
              variable names.
            </li>
            <li>
              Everything a person reads as prose is Instrument Sans, including
              in documentation.
            </li>
            <li>Sentence case everywhere. No title case, no all-caps headlines.</li>
          </ul>
        </section>

        <!-- =============================================== symbols -->
        <section class="brand__section" id="symbols">
          <h2 class="heading">Terminal symbols</h2>
          <p>
            These are documentation and marketing conventions, not output the
            CLI prints. They exist so a reader can tell, at a glance, which line
            they wrote and which line the machine produced.
          </p>

          <ul class="symbols">
            {
              symbols.map((symbol) => (
                <li class="symbols__row">
                  <span class:list={['symbols__glyph', `symbols__glyph--${symbol.tone}`]}>
                    {symbol.glyph}
                  </span>
                  <span class="symbols__meta">
                    <span class="symbols__name">{symbol.name}</span>
                    <span class="symbols__meaning">{symbol.meaning}</span>
                  </span>
                </li>
              ))
            }
          </ul>

          <p class="note">
            Use one pair per example: <code>›</code> for the request,
            <code>→</code> for the command. Do not stack three or four glyphs on
            one illustration — the transformation is the point, and it only has
            two sides.
          </p>
        </section>

        <!-- ================================================= voice -->
        <section class="brand__section" id="voice">
          <h2 class="heading">Voice</h2>

          <ol class="principles">
            <li>
              <span class="principles__head">Say less.</span> If a sentence can
              go, it goes. Two words beat a paragraph when the two words are
              exact.
            </li>
            <li>
              <span class="principles__head">Prefer plain language.</span>
              Ordinary verbs, ordinary nouns. No “leverage”, no “seamless”, no
              “powered by”.
            </li>
            <li>
              <span class="principles__head">Be confident without pretending
              the model is infallible.</span> State what happens. Never claim
              accuracy, safety or intelligence the product does not have.
            </li>
            <li>
              <span class="principles__head">Put humour around the workflow,
              never around risk.</span> Flag archaeology is funny. A destructive
              command is not.
            </li>
            <li>
              <span class="principles__head">One small wink at a time.</span>
              A page gets one. A paragraph gets none if the page already used
              its one.
            </li>
            <li>
              <span class="principles__head">Avoid hype and anthropomorphic AI
              language.</span> No copilots, no agents on your team, no
              unleashing anything.
            </li>
          </ol>

          <h3 class="heading" id="copy-examples">Copy examples</h3>
          <div class="copytable">
            {
              copyExamples.map((example) => (
                <div class="copytable__row">
                  <p class="copytable__good">
                    <span class="copytable__tag mono">Good</span>
                    {example.good}
                  </p>
                  <p class="copytable__bad">
                    <span class="copytable__tag mono">Bad</span>
                    {example.bad}
                  </p>
                  <p class="copytable__why">{example.why}</p>
                </div>
              ))
            }
          </div>

          <h3 class="heading" id="naming">Naming</h3>
          <ul class="plain">
            <li>
              <strong>Smartly</strong> — the product, in prose and headlines.
            </li>
            <li>
              <strong><code>smartly</code></strong> — the binary, the command,
              and the text logo. Always lowercase, always monospaced.
            </li>
            <li>
              Providers are written as their config values:
              <code>anthropic</code>, <code>openai</code>,
              <code>claude-cli</code>, <code>codex-cli</code>.
            </li>
          </ul>
        </section>

        <!-- ================================================ in use -->
        <section class="brand__section" id="in-use">
          <h2 class="heading">In use</h2>
          <p>
            Two worked examples of the voice and the symbols together. Both are
            copy-ready.
          </p>

          <h3 class="heading" id="readme-example">README opening</h3>
          <div data-copyable>
            <pre data-copy-label="README example"><code>{`# smartly >_

Tell your shell what you mean.

    › remove all worktrees except main
    → git worktree remove /Users/you/project-fix

smartly turns one plain English sentence into one executable shell
command, and — by default — runs it immediately.

**Auto-run is the default, including for destructive commands.**
There is no confirmation prompt unless you configure one.`}</code></pre>
          </div>
          <p class="caption">
            The consequence is stated in the opening, not buried in a later
            section. That placement is part of the brand, not a formatting
            choice.
          </p>

          <h3 class="heading" id="docs-example">Documentation callout</h3>
          <div data-copyable>
            <pre data-copy-label="documentation example"><code>{`! This runs the command. Immediately.

  execution.mode defaults to auto: smartly generates one shell
  command and runs it with no confirmation prompt, including when
  the command is destructive. Add --dry-run until you have a feel
  for what it produces.`}</code></pre>
          </div>
          <p class="caption">
            Title states the consequence. Body states the mechanism. Last line
            gives the reader something to do. No apology, no reassurance.
          </p>

          <p class="brand__foot">
            Source for every asset and token on this page lives in the
            <a href={REPO_URL} rel="noopener">smartly-cli repository</a>.
          </p>
        </section>
      </div>
    </div>
  </article>
</Base>

<style>
  /* ---------------------------------------------------------------- hero */
  .brand__hero {
    padding-block: clamp(var(--s-7), 6vw, var(--s-9)) var(--s-7);
  }

  .brand__title {
    font-size: clamp(2.25rem, 1.5rem + 3.2vw, 4rem);
    letter-spacing: var(--tracking-display);
    line-height: 0.99;
  }

  .brand__lede {
    margin-top: var(--s-5);
    max-width: 56ch;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  /* -------------------------------------------------------------- layout */
  .brand__layout {
    display: grid;
    gap: var(--s-6);
    padding-bottom: var(--s-8);
  }

  .brand__toc {
    display: none;
  }

  .brand__toc-title {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--s-3);
  }

  .brand__toc ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    border-left: 1px solid var(--rule-white);
  }

  .brand__toc a {
    display: block;
    padding: 0.1rem 0 0.1rem 0.75rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.8125rem;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .brand__toc a:hover {
    color: var(--ink);
  }

  .brand__toc a[aria-current='true'] {
    color: var(--ink);
    border-left-color: var(--cyan);
  }

  .brand__body {
    min-width: 0;
    max-width: 74ch;
  }

  .brand__section + .brand__section {
    margin-top: var(--s-8);
  }

  .brand__section > * + * {
    margin-top: var(--s-4);
  }

  .brand__section :global(h2) {
    font-size: var(--step-3);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule-white);
    scroll-margin-top: calc(var(--header-h) + var(--s-5));
  }

  .brand__section :global(h3) {
    margin-top: var(--s-6);
    scroll-margin-top: calc(var(--header-h) + var(--s-5));
  }

  .brand__section :global(h4) {
    scroll-margin-top: calc(var(--header-h) + var(--s-5));
  }

  .brand__big {
    font-size: var(--step-2);
    line-height: 1.28;
    letter-spacing: -0.02em;
