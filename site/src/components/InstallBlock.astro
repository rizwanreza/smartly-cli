---
/**
 * The install command, with Homebrew leading and `go install` one click away.
 * Brew is first because it needs no Go toolchain and the macOS binaries are
 * signed and notarized, so it is the shortest path for most readers.
 *
 * Works without JavaScript: both panels render, the Homebrew one visible.
 * The choice is shared across every install block on the page (see initTabs).
 */
interface Props {
  /** `size="lg"` is the hero treatment. */
  size?: 'md' | 'lg';
}

const { size = 'md' } = Astro.props;

const id = `install-${Math.random().toString(36).slice(2, 9)}`;

const methods = [
  {
    key: 'brew',
    label: 'Homebrew',
    command: 'brew install rizwanreza/tap/smartly',
  },
  {
    key: 'go',
    label: 'Go',
    command: 'go install github.com/rizwanreza/smartly-cli/cmd/smartly@latest',
  },
] as const;
---

<div class:list={['install-group', `install-group--${size}`]} data-tabs="install">
  <div class="install-group__tabs" role="tablist" aria-label="Install method">
    {
      methods.map((method, i) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${method.key}`}
          data-key={method.key}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`${id}-panel-${method.key}`}
          tabindex={i === 0 ? 0 : -1}
        >
          {method.label}
        </button>
      ))
    }
  </div>

  {
    methods.map((method, i) => (
      <div
        role="tabpanel"
        id={`${id}-panel-${method.key}`}
        data-key={method.key}
        aria-labelledby={`${id}-tab-${method.key}`}
        tabindex={0}
        hidden={i !== 0}
      >
        <div class:list={['install', `install--${size}`]}>
          <code class="install__cmd">
            <span class="install__prompt" aria-hidden="true">
              $
            </span>
            {method.command}
          </code>
          <button
            type="button"
            class="install__copy"
            data-install-copy
            data-command={method.command}
          >
            <span data-install-label>Copy</span>
            <span class="sr-only">install command</span>
          </button>
        </div>
      </div>
    ))
  }
</div>

<style>
  .install-group__tabs {
    display: flex;
    gap: 0.15rem;
  }

  .install-group__tabs button {
    position: relative;
    background: none;
    border: 0;
    padding: 0.4rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    cursor: pointer;
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .install-group__tabs button:hover {
    color: var(--ink);
    background: var(--paper);
  }

  .install-group__tabs button[aria-selected='true'] {
    color: var(--ink);
    font-weight: 500;
  }

  .install-group__tabs button[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0;
    height: 2px;
    background: var(--cyan);
  }

  .install-group [role='tabpanel']:focus-visible {
    outline-offset: 4px;
  }

  .install {
    display: flex;
    align-items: stretch;
    gap: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper);
    overflow: hidden;
    max-width: 100%;
  }

  .install__cmd {
    flex: 1;
    min-width: 0;
    display: flex;
    gap: 0.6em;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: 0.7rem 0.9rem;
    overflow-x: auto;
    white-space: nowrap;
    background: none;
    border: 0;
  }

  .install--lg .install__cmd {
    font-size: 0.875rem;
    padding: 0.9rem 1rem;
  }

  .install__prompt {
    color: var(--cyan-deep);
    flex: none;
  }

  .install__copy {
    flex: none;
    border: 0;
    border-left: 1px solid var(--rule-strong);
    background: var(--white);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-inline: 0.9rem;
    cursor: pointer;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }

  .install__copy:hover {
    color: var(--ink);
    background: var(--paper-deep);
  }

  .install__copy[data-copied] {
    color: var(--cyan-text);
  }
</style>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-install-copy]')
    .forEach((button) => {
      const label = button.querySelector<HTMLElement>('[data-install-label]')!;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.command ?? '');
          label.textContent = 'Copied';
        } catch {
          label.textContent = 'Press ⌘C';
        }
        button.dataset.copied = 'true';
        window.setTimeout(() => {
          label.textContent = 'Copy';
          delete button.dataset.copied;
        }, 1800);
      });
    });
</script>
