---
interface Props {
  name: string;
  hex: string;
  token: string;
  role: string;
  /** Draw a hairline around the chip — needed for white and near-white. */
  outline?: boolean;
}

const { name, hex, token, role, outline = false } = Astro.props;
---

<button
  class="swatch"
  type="button"
  data-copy-value={hex}
  aria-label={`Copy ${name} hex value ${hex}`}
>
  <span
    class:list={['swatch__chip', outline && 'swatch__chip--outline']}
    style={`background:${hex}`}></span>
  <span class="swatch__meta">
    <span class="swatch__name">{name}</span>
    <span class="swatch__hex mono" data-copy-feedback>{hex}</span>
    <span class="swatch__token mono">{token}</span>
    <span class="swatch__role">{role}</span>
  </span>
</button>

<style>
  .swatch {
    display: grid;
    gap: var(--s-3);
    text-align: left;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    width: 100%;
  }

  .swatch__chip {
    display: block;
    height: 84px;
    border-radius: var(--radius);
    transition: transform var(--dur) var(--ease);
  }

  .swatch__chip--outline {
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  .swatch:hover .swatch__chip {
    transform: translateY(-2px);
  }

  .swatch__meta {
    display: grid;
    gap: 0.1rem;
  }

  .swatch__name {
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.012em;
  }

  .swatch__hex {
    font-size: 0.8125rem;
    color: var(--cyan-text);
  }

  .swatch__token {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .swatch__role {
    font-size: 0.8125rem;
    color: var(--ink-muted);
    margin-top: 0.15rem;
  }

  .swatch[data-copied] .swatch__hex {
    color: var(--ink);
  }
</style>
