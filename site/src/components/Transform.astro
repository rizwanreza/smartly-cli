---
/**
 * The site's signature device: one plain-English request, one shell command.
 * `›` marks what you typed, `→` marks what smartly generated.
 */
interface Props {
  request: string;
  command: string;
}

const { request, command } = Astro.props;
---

<figure class="transform" data-copyable>
  <div class="transform__row transform__row--in">
    <span class="transform__glyph" aria-hidden="true">›</span>
    <span class="transform__text">{request}</span>
  </div>
  <div class="transform__row transform__row--out">
    <span class="transform__glyph transform__glyph--out" aria-hidden="true">→</span>
    <pre
      data-copy-label="generated command"><code>{command}</code></pre>
  </div>
</figure>

<style>
  .transform {
    margin-block: var(--s-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--white);
    overflow: hidden;
  }

  .transform__row {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    align-items: start;
    gap: 0.35rem;
    padding: 0.7rem var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .transform__row--in {
    border-bottom: 1px solid var(--rule-white);
    color: var(--ink-muted);
  }

  .transform__row--out {
    background: var(--paper);
    padding-block: 0;
  }

  .transform__glyph {
    color: var(--ink-faint);
    text-align: center;
  }

  .transform__glyph--out {
    color: var(--cyan-deep);
    padding-block: 0.7rem;
  }

  .transform__text {
    overflow-wrap: anywhere;
  }

  .transform__row--out :global(pre) {
    margin: 0;
    border: 0;
    border-radius: 0;
    padding: 0.7rem 0;
    background: none;
    font-size: inherit;
  }

  .transform :global(.code-block) {
    margin: 0;
  }

  .transform :global(.copy-btn) {
    top: 6px;
    right: 6px;
  }
</style>
