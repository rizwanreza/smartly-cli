---
import { withBase } from '../lib/url';
import { neighbours, docHref } from '../lib/nav';

interface Props {
  slug: string;
}

const { prev, next } = neighbours(Astro.props.slug);
---

<nav class="prevnext" aria-label="Page">
  {
    prev ? (
      <a class="prevnext__link prevnext__link--prev" href={withBase(docHref(prev.slug))} rel="prev">
        <span class="prevnext__dir mono">← Previous</span>
        <span class="prevnext__label">{prev.label}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next && (
      <a class="prevnext__link prevnext__link--next" href={withBase(docHref(next.slug))} rel="next">
        <span class="prevnext__dir mono">Next →</span>
        <span class="prevnext__label">{next.label}</span>
      </a>
    )
  }
</nav>

<style>
  .prevnext {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule-white);
  }

  .prevnext__link {
    display: grid;
    gap: 0.2rem;
    padding: var(--s-4);
    border: 1px solid var(--rule-white);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }

  .prevnext__link:hover {
    border-color: var(--rule-strong);
    background: var(--paper);
    color: var(--ink);
  }

  .prevnext__link--next {
    text-align: right;
  }

  .prevnext__dir {
    font-size: var(--label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .prevnext__link:hover .prevnext__dir {
    color: var(--cyan-text);
  }

  .prevnext__label {
    font-weight: 500;
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
  }

  @media (min-width: 40rem) {
    .prevnext {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-4);
    }
  }
</style>
